{
  "name": "trip-gacha",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "art": "node scripts/copy-art.mjs",
    "names:check": "node scripts/export-card-names.mjs --check",
    "map": "node scripts/build-map.mjs",
    "map:roads": "node scripts/fetch-roads.mjs",
    "map:data": "node scripts/build-map-data.mjs",
    "route:fetch": "node scripts/fetch-transit.mjs",
    "route:data": "node scripts/build-route-data.mjs",
    "route:check": "node scripts/route-accuracy.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/yusei-magic": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "gsap": "^3.15.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
