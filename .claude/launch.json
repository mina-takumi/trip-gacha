{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "mockups"
      ],
      "port": 8765
    },
    {
      "name": "maptest",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../トリップガチャ-地図テスト",
        "run",
        "dev"
      ],
      "port": 5174
    }
  ]
}
