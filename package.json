  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
